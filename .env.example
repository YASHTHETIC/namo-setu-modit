# =============================================================================
# MODIT — Environment Variables
# =============================================================================
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.
# =============================================================================

# ─── Backend (Hostinger VPS: local PostgreSQL + Redis via setup.sh) ──

# Local PostgreSQL (created by deploy/setup.sh)
DATABASE_URL=postgresql+asyncpg://modit:change-me@localhost:5432/modit

# Local Redis (created by deploy/setup.sh)
REDIS_URL=redis://localhost:6379/0

# JWT — generate a strong random secret (e.g. openssl rand -hex 32)
JWT_SECRET_KEY=replace-with-64-char-random-hex
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS — comma-separated list of allowed origins
BACKEND_CORS_ORIGINS=https://modit.in,https://api.modit.in,http://localhost:3001

# Environment
ENVIRONMENT=production
LOG_LEVEL=INFO

# First-staff bootstrap: this login email auto-gets super_admin on
# register/login. Set once on the server, then remove. Unset = disabled.
BOOTSTRAP_ADMIN_EMAIL=you@example.com

# Phone-OTP login: generic SMS gateway (POST {phone, code, sender}).
# Without a gateway, OTP cannot send; OTP_DEBUG_TO_LOGS=true prints codes
# to server logs for internal testing only (never to the client).
# SMS_GATEWAY_URL=https://api.msg91.com/api/v5/flow/
# SMS_API_KEY=xxx
# SMS_SENDER=MODIT
# OTP_DEBUG_TO_LOGS=false

# ─── Email (SMTP) ───────────────────────────────────────────────────────────

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@yourdomain.com

# ─── Payment (Stripe) ──────────────────────────────────────────────────────

STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ─── Payment (Razorpay) ────────────────────────────────────────────────────
# BACKEND env only (/opt/modit/.env on the server). The checkout widget
# receives the key id per-order from the API; NEXT_PUBLIC_* variants of
# these are never read by the app.
# Live = rzp_live_... (switch in the Razorpay dashboard after KYC).

RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx
# RAZORPAY_WEBHOOK_SECRET=   # (planned) payment.captured/failed webhook

# ─── Google Maps ────────────────────────────────────────────────────────────

GOOGLE_MAPS_API_KEY=AIzaSyxxx

# ─── AI (OpenAI / LangChain) ───────────────────────────────────────────────

OPENAI_API_KEY=sk-xxx
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=

# ─── Cloudinary (File Upload) ──────────────────────────────────────────────

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=123456789
CLOUDINARY_API_SECRET=your-api-secret

# ─── Frontend URL ───────────────────────────────────────────────────────────

FRONTEND_URL=https://modit.in

# ─── MODIT Frontend ─────────────────────────────────────────────────────────

# Frontend API base. When unset, the app uses same-origin /api/v1 (served by
# nginx on the VPS, by a Vercel rewrite in the cloud). Set an absolute URL
# only if the API lives somewhere else entirely.
# NEXT_PUBLIC_API_BASE_URL=https://api.modit.in/api/v1

# Staff PIN for /admin (6 digits; setup.sh generates one — default 1234 is demo-only)
NEXT_PUBLIC_ADMIN_PIN=123456

# ─── Celery (optional) ─────────────────────────────────────────────────────

# CELERY_BROKER_URL=redis://...
# CELERY_RESULT_BACKEND=redis://...

# ─── Legacy / Docker-only ──────────────────────────────────────────────────

# CHROMA_DB_PATH=/data/chroma
# FAISS_INDEX_PATH=/data/faiss
