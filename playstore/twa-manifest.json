{
  "targetUrl": "https://modit.in/?source=pwa&utm_source=playstore",
  "packageName": "in.modit.app",
  "name": "MODIT - Construction Materials",
  "shortName": "MODIT",
  "display": [
    "standalone"
  ],
  "themeColor": {
    "extractedColor": "#2D1B69",
    "hashColor": "#2D1B69"
  },
  "backgroundColor": "#150726",
  "splashColor": "#2D1B69",
  "enableNotifications": true,
  "retainedBundles": [],
  "signingKey": {
    "path": "playstore/keys/modit-upload.keystore",
    "alias": "modit-upload"
  },
  "fallbackType": "customtabs",
  "orientation": "portrait",
  "enableSiteSettingsShortcut": true,
  "webManifestUrl": "https://modit.in/manifest.json",
  "shortcuts": [
    {
      "name": "Shop products",
      "short_name": "Shop",
      "url": "/products?source=pwa&utm_source=playstore",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Track order",
      "short_name": "Track",
      "url": "/orders?source=pwa&utm_source=playstore",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    }
  ],
  "features": {}
}
